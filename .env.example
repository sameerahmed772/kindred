# ==============================================================================
# KINDRED — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env.local and fill with real credentials. Never commit .env.local.
# ==============================================================================

# --- Public App & Supabase ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# --- Server-Only Supabase Admin (Webhooks, Inngest, GDPR Delete) ---
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY

# --- Google Gemini API ---
GEMINI_API_KEY=AIzaSyYOUR_KEY
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# --- Upstash Redis Rate Limiting ---
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# --- Inngest Durable Workflows ---
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Web Push VAPID Keys (npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@kindred.app

# --- Stripe Billing & EU VAT ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PLUS=price_...
STRIPE_PRICE_PRO=price_...

# --- Analytics & Admin Eval Secret ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
ADMIN_API_SECRET=replace-with-a-32-character-random-secret

# --- Optional E2E & RLS Test Accounts ---
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
